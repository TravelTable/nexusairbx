  "proceduralHelperSource": "-- Inline this pure helper before View.build; the trusted builder isolates View.\n-- Every glyph uses the same solid, front-facing, monochrome family. No assets.\n-- options = {size = 32, padding = 12, color = Color3, name = \"ShopIcon\"}\nlocal function createNexusIcon(parent, role, options)\n    options = options or {}\n    local holder = Instance.new(\"Frame\")\n    holder.Name = options.name or (role .. \"Icon\")\n    holder.BackgroundTransparency = 1\n    holder.BorderSizePixel = 0\n    holder.Size = UDim2.fromOffset(options.size or 32, options.size or 32)\n    holder.Parent = parent\n    local aspect = Instance.new(\"UIAspectRatioConstraint\")\n    aspect.AspectRatio = 1\n    aspect.Parent = holder\n    local padding = math.clamp(options.padding or 12, 0, 25) / 100\n    local canvas = Instance.new(\"Frame\")\n    canvas.Name = \"Glyph\"\n    canvas.BackgroundTransparency = 1\n    canvas.BorderSizePixel = 0\n    canvas.Position = UDim2.fromScale(padding, padding)\n    canvas.Size = UDim2.fromScale(1 - padding * 2, 1 - padding * 2)\n    canvas.Parent = holder\n    local color = options.color or Color3.fromRGB(255, 255, 255)\n    local function shape(x, y, w, h, rotation, round)\n        local part = Instance.new(\"Frame\")\n        part.Name = \"GlyphPart\"\n        part.AnchorPoint = Vector2.new(0.5, 0.5)\n        part.Position = UDim2.fromScale(x, y)\n        part.Size = UDim2.fromScale(w, h)\n        part.Rotation = rotation or 0\n        part.BackgroundColor3 = color\n        part.BorderSizePixel = 0\n        part.Parent = canvas\n        if round then\n            local corner = Instance.new(\"UICorner\")\n            corner.CornerRadius = UDim.new(round, 0)\n            corner.Parent = part\n        end\n        return part\n    end\n    local function bar(x1, y1, x2, y2, width)\n        local dx, dy = x2 - x1, y2 - y1\n        return shape((x1 + x2) / 2, (y1 + y2) / 2,\n            math.sqrt(dx * dx + dy * dy), width or 0.14,\n            math.deg(math.atan2(dy, dx)), 0.5)\n    end\n    local function ring(x, y, radius, width)\n        -- Segmented ring stays proportional at every size, without pixel strokes.\n        for index = 0, 11 do\n            local a, b = index * math.pi / 6, (index + 1) * math.pi / 6\n            bar(x + math.cos(a) * radius, y + math.sin(a) * radius,\n                x + math.cos(b) * radius, y + math.sin(b) * radius, width or 0.12)\n        end\n    end\n    local function ticket()\n        bar(0.18, 0.2, 0.82, 0.2)\n        bar(0.18, 0.8, 0.82, 0.8)\n        bar(0.18, 0.2, 0.18, 0.36)\n        bar(0.18, 0.64, 0.18, 0.8)\n        bar(0.82, 0.2, 0.82, 0.36)\n        bar(0.82, 0.64, 0.82, 0.8)\n        for index = 0, 2 do shape(0.62, 0.32 + index * 0.18, 0.07, 0.09, 0, 0.3) end\n        bar(0.29, 0.4, 0.41, 0.5, 0.09)\n        bar(0.41, 0.5, 0.29, 0.6, 0.09)\n    end\n    if role == \"play\" then\n        -- Sixteen narrow strips make a triangle without a glyph font dependency.\n        for index = 0, 15 do\n            local x = index / 16\n            shape(0.22 + x * 0.58, 0.5, 0.58 / 16 + 0.005, 0.76 * (1 - x), 0, nil)\n        end\n    elseif role == \"close\" or role == \"plus\" then\n        shape(0.5, 0.5, 0.88, 0.15, role == \"close\" and 45 or 0, 0.5)\n        shape(0.5, 0.5, 0.88, 0.15, role == \"close\" and -45 or 90, 0.5)\n    elseif role == \"minus\" then\n        shape(0.5, 0.5, 0.85, 0.15, 0, 0.5)\n    elseif role == \"back\" or role == \"chevron\" then\n        local edge, point = 0.68, 0.32\n        if role == \"chevron\" then edge, point = 0.32, 0.68 end\n        bar(edge, 0.16, point, 0.5)\n        bar(point, 0.5, edge, 0.84)\n    elseif role == \"settings\" then\n        ring(0.5, 0.5, 0.25, 0.16)\n        for index = 0, 7 do\n            local angle = index * math.pi / 4\n            shape(0.5 + math.cos(angle) * 0.33, 0.5 + math.sin(angle) * 0.33,\n                0.26, 0.16, math.deg(angle), 0.3)\n        end\n    elseif role == \"codes\" then\n        ticket()\n    elseif role == \"shop\" or role == \"inventory\" or role == \"lock\" then\n        ring(0.5, 0.32, 0.2, 0.12)\n        shape(0.5, 0.66, 0.72, 0.54, 0, 0.12)\n    elseif role == \"gift\" then\n        shape(0.5, 0.65, 0.76, 0.58, 0, 0.09)\n        shape(0.5, 0.32, 0.92, 0.16, 0, 0.2)\n        ring(0.35, 0.16, 0.1, 0.09)\n        ring(0.65, 0.16, 0.1, 0.09)\n    elseif role == \"home\" then\n        bar(0.1, 0.46, 0.5, 0.12)\n        bar(0.5, 0.12, 0.9, 0.46)\n        bar(0.24, 0.42, 0.24, 0.85)\n        bar(0.76, 0.42, 0.76, 0.85)\n        bar(0.24, 0.85, 0.76, 0.85)\n    elseif role == \"currency\" then\n        ring(0.5, 0.5, 0.38, 0.12)\n        shape(0.5, 0.5, 0.15, 0.43, 0, 0.4)\n    elseif role == \"profile\" then\n        shape(0.5, 0.25, 0.38, 0.38, 0, 0.5)\n        shape(0.5, 0.75, 0.8, 0.4, 0, 0.5)\n    elseif role == \"search\" then\n        ring(0.41, 0.4, 0.28, 0.13)\n        bar(0.63, 0.63, 0.89, 0.89, 0.15)\n    elseif role == \"quest\" then\n        bar(0.22, 0.54, 0.43, 0.75, 0.16)\n        bar(0.43, 0.75, 0.82, 0.23, 0.16)\n    else\n        ring(0.5, 0.5, 0.39, 0.11)\n        shape(0.5, 0.31, 0.14, 0.14, 0, 0.5)\n        shape(0.5, 0.62, 0.14, 0.3, 0, 0.4)\n    end\n    return holder\nend\n",
  "buttonEffectsSource": "-- Original reference implementation from 06-ui-motion-and-interaction.md\n-- Reviewed 2026-09-11. Not Roblox Studio runtime-verified.\n\nlocal TweenService = game:GetService(\"TweenService\")\nlocal GuiService = game:GetService(\"GuiService\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal ButtonFeedback = {}\nlocal bound = setmetatable({}, { __mode = \"k\" })\nlocal lastSoundAt = { hover = -math.huge, click = -math.huge }\n\n-- Backward compatible: bind(button, childVisual) or bind(button, options).\n-- Prefer options.visual = the stable button's child Visual frame.\nfunction ButtonFeedback.bind(button, visualOrOptions, options)\n    local visual\n    if typeof(visualOrOptions) == \"Instance\" then\n        visual = visualOrOptions\n        options = options or {}\n    else\n        options = visualOrOptions or {}\n        visual = options.visual or button:FindFirstChild(\"Visual\") or button\n    end\n    assert(button:IsA(\"GuiButton\"), \"expected a GuiButton\")\n    assert(visual:IsA(\"GuiObject\") and (visual == button or visual:IsDescendantOf(button)),\n        \"visual must be a child visual inside the button\")\n    assert(not bound[button], \"button already has a feedback binding\")\n    assert(not visual:FindFirstChildOfClass(\"UIScale\"),\n        \"visual UIScale already has an owner\")\n    local scale = Instance.new(\"UIScale\")\n    scale.Name = \"FeedbackScale\"\n    scale.Parent = visual\n    local alive, focused = true, GuiService.SelectedObject == button\n    local currentTween = nil\n    local shadowTween = nil\n    local connections = {}\n    local sounds = {}\n    local originalAutoColor = button.AutoButtonColor\n    button.AutoButtonColor = false\n    local controller = {}\n    bound[button] = controller\n    local previousState = nil\n    local hoverScale = math.clamp(tonumber(options.hoverScale) or 1.05, 1, 1.1)\n    local pressScale = math.clamp(tonumber(options.pressScale) or 0.95, 0.85, 1)\n    local duration = math.clamp(tonumber(options.duration) or 0.12, 0.06, 0.3)\n    local shadow = options.shadow\n    local shadowPosition = shadow and shadow.Position\n\n    local function soundFor(kind, soundId)\n        if type(soundId) ~= \"string\" or not soundId:match(\"^rbxassetid://%d+$\") then return end\n        local sound = Instance.new(\"Sound\")\n        sound.Name = \"Feedback_\" .. kind\n        sound.SoundId = soundId\n        sound.Volume = math.clamp(tonumber(options.volume) or 0.18, 0, 0.35)\n        sound.Parent = button\n        sounds[kind] = sound\n    end\n    soundFor(\"hover\", options.hoverSound)\n    soundFor(\"click\", options.clickSound)\n\n    local function playSound(kind)\n        if not alive or not button.Interactable or options.sounds == false then return end\n        local sound = sounds[kind]\n        local now = os.clock()\n        local delay = kind == \"hover\" and 0.12 or 0.08\n        if not sound or now - lastSoundAt[kind] < delay then return end\n        lastSoundAt[kind] = now\n        sound.TimePosition = 0\n        sound:Play()\n    end\n\n    local function pointerAvailable()\n        return UserInputService.MouseEnabled\n            and UserInputService:GetLastInputType() ~= Enum.UserInputType.Touch\n    end\n\n    local function refresh()\n        if not alive then return end\n        local state = button.GuiState\n        local target = 1\n        if button.Interactable then\n            if state == Enum.GuiState.Press then\n                target = pressScale\n            elseif (state == Enum.GuiState.Hover and pointerAvailable() and options.hoverEnabled ~= false) or focused then\n                target = hoverScale\n            end\n        end\n        if state == Enum.GuiState.Hover and previousState ~= state and pointerAvailable() and options.hoverEnabled ~= false then\n            playSound(\"hover\")\n        end\n        previousState = state\n        if currentTween then\n            currentTween:Cancel()\n            currentTween = nil\n        end\n        if shadowTween then shadowTween:Cancel() end\n        if GuiService.ReducedMotionEnabled or options.animations == false then\n            scale.Scale = 1\n            if shadow then shadow.Position = shadowPosition end\n            return\n        end\n        currentTween = TweenService:Create(scale,\n            TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),\n            { Scale = target })\n        currentTween:Play()\n        if shadow then\n            local offset = state == Enum.GuiState.Press and -2 or 0\n            shadowTween = TweenService:Create(shadow, TweenInfo.new(duration),\n                { Position = shadowPosition + UDim2.fromOffset(0, offset) })\n            shadowTween:Play()\n        end\n    end\n\n    connections[#connections + 1] = button\n        :GetPropertyChangedSignal(\"GuiState\"):Connect(refresh)\n    connections[#connections + 1] = button\n        :GetPropertyChangedSignal(\"Interactable\"):Connect(refresh)\n    connections[#connections + 1] = button.SelectionGained:Connect(function()\n        focused = true\n        refresh()\n    end)\n    connections[#connections + 1] = button.SelectionLost:Connect(function()\n        focused = false\n        refresh()\n    end)\n    connections[#connections + 1] = GuiService\n        :GetPropertyChangedSignal(\"ReducedMotionEnabled\"):Connect(refresh)\n    connections[#connections + 1] = button.Activated:Connect(function()\n        playSound(\"click\")\n    end)\n\n    function controller:Destroy()\n        if not alive then return end\n        alive = false\n        if currentTween then currentTween:Cancel() end\n        if shadowTween then shadowTween:Cancel() end\n        for _, connection in ipairs(connections) do connection:Disconnect() end\n        for _, sound in pairs(sounds) do sound:Destroy() end\n        bound[button] = nil\n        scale:Destroy()\n        pcall(function() button.AutoButtonColor = originalAutoColor end)\n        if shadow then pcall(function() shadow.Position = shadowPosition end) end\n    end\n    connections[#connections + 1] = button.Destroying:Connect(function()\n        controller:Destroy()\n    end)\n    refresh()\n    return controller\nend\n\nreturn ButtonFeedback\n"
}